<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>@ViewData["Title"] - TechGear Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" />

    <style>

        body {
            display: flex;
            min-height: 100vh;
            background: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            background: #343a40;
            color: white;
            padding-top: 20px;
        }

        .sidebar-title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .sidebar a {
            color: white;
            display: block;
            padding: 12px 20px;
            text-decoration: none;
            font-size: 15px;
        }

            .sidebar a:hover {
                background: #495057;
            }

        .menu-title {
            padding: 10px 20px;
            font-size: 13px;
            color: #adb5bd;
            text-transform: uppercase;
        }

        .content {
            flex: 1;
            padding: 25px;
        }

    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="sidebar-title">
            Quản Trị TechGear
        </div>

        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            🏠 Trang tổng quan
        </a>


        <!-- QUẢN LÝ SẢN PHẨM -->
        <div class="menu-title">Quản lý sản phẩm</div>

        <a asp-area="Admin" asp-controller="AdminProducts" asp-action="Index">
            📦 Danh sách sản phẩm
        </a>

        <a asp-area="Admin" asp-controller="AdminCategories" asp-action="Index">
            📂 Danh mục sản phẩm
        </a>

        <a asp-area="Admin" asp-controller="AdminProductReviews" asp-action="Index">
            ⭐ Đánh giá sản phẩm
        </a>

        <!-- QUẢN LÝ BÁN HÀNG -->
        <div class="menu-title">Quản lý bán hàng</div>

        <a asp-area="Admin" asp-controller="AdminOrders" asp-action="Index">
            🧾 Đơn hàng
        </a>


        <!-- QUẢN LÝ KHÁCH HÀNG -->
        <div class="menu-title">Quản lý khách hàng</div>

        <a asp-area="Admin" asp-controller="AdminUsers" asp-action="Index">
            👤 Người dùng
        </a>

        <a asp-area="Admin" asp-controller="AdminContacts" asp-action="Index">
            📩 Liên hệ khách hàng
        </a>


        <!-- QUẢN LÝ NỘI DUNG -->
        <div class="menu-title">Quản lý nội dung</div>

        <a asp-area="Admin" asp-controller="AdminNews" asp-action="Index">
            📰 Tin tức
        </a>

        <a asp-area="Admin" asp-controller="AdminEvents" asp-action="Index">
            🎉 Sự kiện
        </a>

        <a asp-area="Admin" asp-controller="AdminSliders" asp-action="Index">
            🖼 Slider trang chủ
        </a>

        <hr style="background:white">

        <a asp-area="" asp-controller="Home" asp-action="Index">
            🌐 Xem trang web
        </a>

    </div>


    <!-- CONTENT -->
    <div class="content">

        @RenderBody()

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>
