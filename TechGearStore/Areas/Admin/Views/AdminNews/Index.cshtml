@model X.PagedList.IPagedList<TechGearStore.Models.News>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Quản lý tin tức";
}

<h2 class="mb-4">Quản lý tin tức</h2>

<form method="get">
    <div class="row mb-3">
        <div class="col-md-3">
            <a asp-action="Create" class="btn btn-success w-100">
                + Thêm tin tức
            </a>
        </div>
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Tìm theo tiêu đề..." />
                <button type="submit" class="btn btn-primary">
                    Tìm
                </button>
            </div>
        </div>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:120px">Ảnh</th>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th style="width:160px">Ngày đăng</th>
            <th style="width:180px">Trạng thái</th>
            <th style="width:220px">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                         alt="@item.Title"
                         style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #ddd;" />
                </td>
                <td>@item.Title</td>
                <td>
                    @(item.Content?.Length > 80 ? item.Content.Substring(0, 80) + "..." : item.Content)
                </td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if ((DateTime.Now - item.CreatedDate).TotalDays <= 7)
                    {
                        <span class="badge bg-success">Mới</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Cũ</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <button class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id)">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">
        Không tìm thấy tin tức nào.
    </div>
}

<div class="mt-3">
    @Html.PagedListPager(Model,
            page => Url.Action("Index", new { page, search = ViewBag.Search }),
            new PagedListRenderOptions
    {
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" }
    })
</div>

<script>
    function confirmDelete(id) {
        if (confirm("Bạn có chắc muốn xóa tin tức này?")) {
            window.location.href = "/Admin/AdminNews/Delete/" + id;
        }
    }
</script>