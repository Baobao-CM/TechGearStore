@model TechGearStore.Models.News

@{
    ViewData["Title"] = "Chi tiết tin tức";
}

@if (Model == null)
{
    <div class="alert alert-danger">
        Không tìm thấy tin tức này.
    </div>
    return;
}

<h2 class="mb-4">Chi tiết tin tức</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <!-- Ảnh tin tức -->
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)"
                     alt="@(Model.Title ?? "Không có tiêu đề")"
                     class="img-fluid rounded border shadow-sm"
                     style="max-height:350px; object-fit:cover;" />
            </div>

            <!-- Thông tin tin tức -->
            <div class="col-md-8">
                <h4 class="card-title mb-3">@(Model.Title ?? "Không có tiêu đề")</h4>

                <div class="mb-3">
                    <strong>Ngày đăng:</strong> @(Model.CreatedDate.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có ngày")
                </div>

                <div class="mb-3">
                    <strong>Trạng thái:</strong>
                    @if (Model.CreatedDate != default && (DateTime.Now - Model.CreatedDate).TotalDays <= 7)
                    {
                        <span class="badge bg-success">Mới</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Cũ</span>
                    }
                </div>

                <div class="mb-4">
                    <strong>Nội dung:</strong>
                    <div style="max-height:400px; overflow-y:auto; padding:12px; background:#f8f9fa; border-radius:6px; border:1px solid #dee2e6;">
                        @if (!string.IsNullOrEmpty(Model.Content))
                        {
                            @Html.Raw(Model.Content)
                        }
                        else
                        {
                            <span class="text-muted">Chưa có nội dung</span>
                        }
                    </div>
                </div>

                <div class="mt-4 d-flex gap-3">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Xóa
                    </a>
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>