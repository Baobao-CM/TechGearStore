@model TechGearStore.Models.News

@{
    ViewData["Title"] = "Chỉnh sửa tin tức";
}

<h2 class="mb-4">Chỉnh sửa tin tức</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="AdminNews"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Title -->
            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label">Tiêu đề tin tức</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Nhập tiêu đề tin tức..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Content -->
            <div class="form-group mb-3">
                <label asp-for="Content" class="form-label">Nội dung tin tức</label>
                <textarea asp-for="Content"
                          class="form-control"
                          rows="8"
                          placeholder="Nhập nội dung chi tiết bài viết..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- Current Image -->
            <div class="form-group mb-3">
                <label class="form-label">Ảnh hiện tại (thumbnail)</label><br />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img id="currentImage"
                         src="@Model.ImageUrl"
                         alt="@Model.Title"
                         style="max-width:200px; border-radius:8px; border:1px solid #ddd; padding:5px;" />
                }
                else
                {
                    <p class="text-muted">Chưa có ảnh thumbnail</p>
                }
            </div>

            <!-- Upload New Image -->
            <div class="form-group mb-3">
                <label class="form-label">Thay ảnh mới</label>
                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*"
                       onchange="previewImage(event)" />
                <span class="text-muted small mt-1 d-block">Định dạng: jpg, jpeg, png, webp. Kích thước khuyến nghị: 800x450px</span>
            </div>

            <!-- Preview New Image -->
            <div class="form-group mb-4">
                <img id="preview"
                     src="/images/no-image.png"
                     alt="Preview ảnh mới"
                     style="max-width:200px; border-radius:8px; border:1px solid #ddd; padding:5px; display:none;" />
            </div>

            <!-- Created Date (readonly) -->
            <div class="form-group mb-3">
                <label class="form-label">Ngày đăng</label>
                <input asp-for="CreatedDate"
                       class="form-control"
                       readonly />
            </div>

            <div class="mt-3 d-flex gap-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                </button>
                <a asp-area="Admin"
                   asp-controller="AdminNews"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            var output = document.getElementById('preview');
            if (event.target.files && event.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function () {
                    output.src = reader.result;
                    output.style.display = "block";
                }
                reader.readAsDataURL(event.target.files[0]);
            } else {
                output.style.display = "none";
            }
        }
    </script>
}