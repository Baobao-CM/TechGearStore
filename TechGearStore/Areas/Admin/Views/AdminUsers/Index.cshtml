@model X.PagedList.IPagedList<TechGearStore.Models.User>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Quản lý người dùng</h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Thêm người dùng
        </a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="get" class="mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm tên hoặc email..." />
                </div>
                <div class="col-md-3">
                    <select name="role" class="form-select">
                        <option value="">-- Tất cả vai trò --</option>
                        @foreach (var r in ViewBag.Roles)
                        {
                            <option value="@r" selected="@(r == ViewBag.Role)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> Lọc</button>
                </div>
            </div>
        </form>

        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.UserId</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.Role == "Admin" ? "bg-danger" : item.Role == "Staff" ? "bg-warning" : "bg-success")">
                                @item.Role
                            </span>
                        </td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                @(item.IsActive ? "Hoạt động" : "Khóa")
                            </span>
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                            <a asp-action="ChangePassword" asp-route-id="@item.UserId" class="btn btn-secondary btn-sm"><i class="fas fa-key"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info text-center">Không tìm thấy người dùng nào.</div>
        }

        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.Search, role = ViewBag.Role }),
                 new PagedListRenderOptions { LiElementClasses = new[] { "page-item" }, PageClasses = new[] { "page-link" } })
    </div>
</div>