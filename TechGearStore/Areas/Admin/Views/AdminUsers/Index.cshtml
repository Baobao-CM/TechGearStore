@model IEnumerable<TechGearStore.Models.User>

<h2 class="mb-4">Quản lý người dùng</h2>

<table class="table table-bordered">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Email</th>
            <th>Password</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.UserId</td>

                <td>@item.FullName</td>

                <td>@item.Email</td>

                <td>@item.Password</td>

                <td>@item.Role</td>

            </tr>
        }

    </tbody>

</table>