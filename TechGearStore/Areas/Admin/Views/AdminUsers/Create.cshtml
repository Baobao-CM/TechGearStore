@model TechGearStore.Models.User

@{
    ViewData["Title"] = "Thêm người dùng";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Thêm người dùng mới</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                <input name="PasswordHash" class="form-control" type="password" required />
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Vai trò</label>
                <select asp-for="Role" class="form-select">
                    <option value="Admin">Admin</option>
                    <option value="Staff">Nhân viên</option>
                    <option value="Customer">Khách hàng</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Tạo người dùng</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}