@model TechGearStore.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<h2 class="mb-4">Chi tiết danh mục</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-bordered">

            <tr>
                <th style="width:200px">Tên danh mục</th>
                <td>@Model.Name</td>
            </tr>

        </table>

        <div class="mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Sửa
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </div>
</div>
