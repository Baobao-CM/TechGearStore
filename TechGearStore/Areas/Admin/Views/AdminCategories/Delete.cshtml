@model TechGearStore.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h2 class="mb-4 text-danger">Xóa danh mục</h2>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <div class="alert alert-danger">
            <strong>Cảnh báo!</strong> Bạn có chắc muốn xóa danh mục này không?
        </div>

        <table class="table table-bordered">

            <tr>
                <th style="width:200px">Tên danh mục</th>
                <td>@Model.Name</td>
            </tr>

        </table>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Xóa danh mục
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Hủy
            </a>

        </form>

    </div>
</div>
