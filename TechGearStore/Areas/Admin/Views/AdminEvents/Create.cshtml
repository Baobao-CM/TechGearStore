@model TechGearStore.Models.Event

@{
    ViewData["Title"] = "Thêm sự kiện";
}

<h2 class="mb-4">Thêm sự kiện</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="AdminEvents"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Tiêu đề sự kiện</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Nhập tiêu đề sự kiện..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả sự kiện</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Nhập mô tả chi tiết sự kiện..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label">Ngày sự kiện</label>
                <input asp-for="EventDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Ảnh sự kiện (thumbnail)</label>
                <input asp-for="ImageFile"
                       type="file"
                       class="form-control"
                       accept="image/*"
                       onchange="previewImage(event)" />
                <span class="text-muted small mt-1 d-block">Định dạng: jpg, jpeg, png, webp</span>
            </div>

            <div class="mb-4">
                <img id="preview"
                     style="max-width:200px; display:none; border-radius:8px; border:1px solid #ddd; padding:5px;" />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">
                    Tạo sự kiện
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            var output = document.getElementById('preview');
            if (event.target.files && event.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function () {
                    output.src = reader.result;
                    output.style.display = "block";
                }
                reader.readAsDataURL(event.target.files[0]);
            } else {
                output.style.display = "none";
            }
        }
    </script>
}