@model TechGearStore.Models.Event

@{
    ViewData["Title"] = "Chi tiết sự kiện";
}

<h2 class="mb-4">Chi tiết sự kiện</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <!-- Ảnh sự kiện -->
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)"
                     alt="@Model.Title"
                     class="img-fluid rounded border shadow-sm"
                     style="max-height:300px; object-fit:cover;" />
            </div>

            <!-- Thông tin sự kiện -->
            <div class="col-md-8">
                <table class="table table-bordered table-hover">
                    <tbody>
                        <tr>
                            <th style="width:200px">Tiêu đề</th>
                            <td><strong>@Model.Title</strong></td>
                        </tr>
                        <tr>
                            <th>Mô tả</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <div style="max-height:200px; overflow-y:auto;">
                                        @Model.Description
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có mô tả</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày sự kiện</th>
                            <td>@Model.EventDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @if (Model.EventDate > DateTime.Now)
                                {
                                    <span class="badge bg-info">Sắp diễn ra</span>
                                }
                                else if (Model.EventDate.Date == DateTime.Today)
                                {
                                    <span class="badge bg-success">Đang diễn ra</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã kết thúc</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-4 d-flex gap-3">
                    <a asp-action="Edit"
                       asp-route-id="@Model.EventId"
                       class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Sửa
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@Model.EventId"
                       class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Xóa
                    </a>
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>