@model TechGearStore.Models.Event

@{
    ViewData["Title"] = "Chi tiết sự kiện";
}

<h2 class="mb-4">Chi tiết sự kiện</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="row">

            <div class="col-md-4">

                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)"
                     class="img-fluid rounded border"
                     style="max-height:250px;object-fit:cover;" />

            </div>

            <div class="col-md-8">

                <table class="table table-bordered">

                    <tr>
                        <th style="width:200px">Tiêu đề</th>
                        <td>@Model.Title</td>
                    </tr>

                    <tr>
                        <th>Mô tả</th>
                        <td>@Model.Description</td>
                    </tr>

                    <tr>
                        <th>Ngày sự kiện</th>
                        <td>@Model.EventDate.ToString("dd/MM/yyyy")</td>
                    </tr>

                </table>

                <div class="mt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.EventId"
                       class="btn btn-warning">
                        Sửa
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>