@model X.PagedList.IPagedList<TechGearStore.Models.Event>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Quản lý sự kiện";
}

<h2 class="mb-4">Quản lý sự kiện</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row mb-3">

    <div class="col-md-2">
        <a asp-action="Create" class="btn btn-success">
            + Thêm sự kiện
        </a>
    </div>

    <div class="col-md-4">
        <form method="get">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Tìm theo tiêu đề sự kiện..." />

        </form>
    </div>

</div>

<table class="table table-bordered table-hover align-middle">

    <thead class="table-dark">

        <tr>
            <th style="width:120px">Ảnh</th>
            <th>Tiêu đề</th>
            <th>Mô tả</th>
            <th style="width:160px">Ngày sự kiện</th>
            <th style="width:220px">Hành động</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                         style="width:90px;height:70px;object-fit:cover;border-radius:6px;" />
                </td>

                <td>
                    @item.Title
                </td>

                <td>
                    @item.Description
                </td>

                <td>
                    @item.EventDate.ToString("dd/MM/yyyy")
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.EventId"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.EventId"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.EventId"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>

<div class="mt-3">

    @Html.PagedListPager(Model,
            page => Url.Action("Index", new
            {
                page,
                search = ViewBag.Search
            }))

</div>