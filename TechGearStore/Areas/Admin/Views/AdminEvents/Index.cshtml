@model X.PagedList.IPagedList<TechGearStore.Models.Event>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Quản lý sự kiện";
}

<h2 class="mb-4">Quản lý sự kiện</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row mb-3">
    <div class="col-md-2">
        <a asp-action="Create" class="btn btn-success w-100">
            + Thêm sự kiện
        </a>
    </div>
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Tìm theo tiêu đề sự kiện..." />
                <button type="submit" class="btn btn-primary">
                    Tìm
                </button>
            </div>
        </form>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:120px">Ảnh</th>
            <th>Tiêu đề</th>
            <th>Mô tả</th>
            <th style="width:160px">Ngày sự kiện</th>
            <th style="width:180px">Trạng thái</th>
            <th style="width:220px">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                         alt="@item.Title"
                         style="width:90px;height:70px;object-fit:cover;border-radius:6px;border:1px solid #ddd;" />
                </td>
                <td>@item.Title</td>
                <td>
                    @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                </td>
                <td>@item.EventDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (item.EventDate > DateTime.Now)
                    {
                        <span class="badge bg-info">Sắp diễn ra</span>
                    }
                    else if (item.EventDate.Date == DateTime.Today)
                    {
                        <span class="badge bg-success">Đang diễn ra</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã kết thúc</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">
        Không tìm thấy sự kiện nào.
    </div>
}

<div class="mt-3">
    @Html.PagedListPager(Model,
            page => Url.Action("Index", new { page, search = ViewBag.Search }),
            new PagedListRenderOptions
    {
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" }
    })
</div>