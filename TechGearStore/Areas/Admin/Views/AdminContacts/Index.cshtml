@model IEnumerable<TechGearStore.Models.ContactInfo>

<h2 class="mb-4">Liên hệ khách hàng</h2>

<table class="table table-bordered">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Nội dung</th>
            <th>Ngày gửi</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Message</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
            </tr>
        }

    </tbody>

</table>