@model TechGearStore.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 class="mb-4">Chi tiết sản phẩm</h2>

<div class="card shadow">
    <div class="card-body">

        <div class="row">

            <!-- ẢNH SẢN PHẨM -->
            <div class="col-md-5 text-center">

                <!-- Ảnh chính -->
                <img id="mainImage"
                     src="@Model.ImageUrl"
                     class="img-fluid mb-3 product-main-image" />

                <!-- Gallery -->
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="gallery-container">

                        <img src="@Model.ImageUrl"
                             class="thumb-image"
                             onclick="changeImage(this.src)" />

                        @foreach (var img in Model.Images)
                        {
                            <img src="@img.ImageUrl"
                                 class="thumb-image"
                                 onclick="changeImage(this.src)" />
                        }

                    </div>
                }

            </div>


            <!-- THÔNG TIN SẢN PHẨM -->
            <div class="col-md-7">

                <dl class="row">

                    <dt class="col-sm-4">
                        Tên sản phẩm
                    </dt>
                    <dd class="col-sm-8">
                        <strong>@Model.ProductName</strong>
                    </dd>

                    <dt class="col-sm-4">
                        Giá
                    </dt>
                    <dd class="col-sm-8 text-danger fw-bold">
                        @Model.Price.ToString("N0") VND
                    </dd>

                    <dt class="col-sm-4">
                        Danh mục
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Category?.Name
                    </dd>

                    <dt class="col-sm-4">
                        Mô tả
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>

                </dl>

                <hr />

                <!-- BUTTON -->
                <div class="mt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-warning">
                        Chỉnh sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-danger">
                        Xóa
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>
<style>

    .product-main-image {
        max-height: 300px;
        border: 1px solid #ddd;
        padding: 5px;
        border-radius: 10px;
        transition: 0.3s;
    }

        .product-main-image:hover {
            transform: scale(1.1);
        }

    .gallery-container {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .thumb-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border: 2px solid #ddd;
        border-radius: 5px;
        cursor: pointer;
        transition: 0.3s;
    }

        .thumb-image:hover {
            border: 2px solid #007bff;
            transform: scale(1.1);
        }

</style>
<script>

    function changeImage(src) {
        document.getElementById("mainImage").src = src;
    }

</script>