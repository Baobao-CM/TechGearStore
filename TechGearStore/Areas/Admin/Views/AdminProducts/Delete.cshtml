@model TechGearStore.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h2 class="mb-4 text-danger">Xóa sản phẩm</h2>

<div class="alert alert-warning" role="alert">
    <strong>Cảnh báo!</strong> Bạn có chắc muốn xóa sản phẩm này không? Hành động này không thể hoàn tác.
</div>

<div class="card shadow" style="max-width:600px;">
    <div class="card-body">
        <div class="text-center mb-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)"
                 alt="@Model.ProductName"
                 style="max-width:200px; border-radius:10px; border:1px solid #ddd; padding:5px;" />
            @if (string.IsNullOrEmpty(Model.ImageUrl))
            {
                <p class="text-muted mt-2">Không có ảnh thumbnail</p>
            }
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-4 fw-bold">
                Tên sản phẩm
            </dt>
            <dd class="col-sm-8">
                @Model.ProductName
            </dd>

            <dt class="col-sm-4 fw-bold">
                Giá
            </dt>
            <dd class="col-sm-8 text-danger fw-bold">
                @Model.Price.ToString("N0") ₫
            </dd>

            <dt class="col-sm-4 fw-bold">
                Tồn kho
            </dt>
            <dd class="col-sm-8">
                @Model.StockQuantity
            </dd>

            <dt class="col-sm-4 fw-bold">
                Trạng thái
            </dt>
            <dd class="col-sm-8">
                @if (Model.StockQuantity > 10)
                {
                    <span class="badge bg-success">Còn hàng</span>
                }
                else if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-warning">Sắp hết hàng</span>
                }
                else
                {
                    <span class="badge bg-danger">Hết hàng</span>
                }
            </dd>

            <dt class="col-sm-4 fw-bold">
                Danh mục
            </dt>
            <dd class="col-sm-8">
                @Model.Category?.Name
            </dd>

            <dt class="col-sm-4 fw-bold">
                Mô tả
            </dt>
            <dd class="col-sm-8">
                @(Model.Description?.Length > 200 ? Model.Description.Substring(0, 200) + "..." : Model.Description)
            </dd>
        </dl>

        <hr />

        <form asp-area="Admin"
              asp-controller="AdminProducts"
              asp-action="Delete"
              method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i> Xóa sản phẩm
                </button>
                <a asp-area="Admin"
                   asp-controller="AdminProducts"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>