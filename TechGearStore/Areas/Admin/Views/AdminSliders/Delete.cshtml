@model TechGearStore.Models.Slider

@{
    ViewData["Title"] = "Xác nhận xóa Slider";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Xác nhận xóa Slider</h4>
    </div>
    <div class="card-body">
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Slider sẽ bị xóa vĩnh viễn khỏi hệ thống.
        </div>

        <div class="row g-4">
            <!-- Ảnh slider (nếu có) -->
            <div class="col-md-5 col-lg-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title"
                         class="img-fluid rounded shadow"
                         style="max-height: 300px; object-fit: contain; border: 1px solid #dee2e6;" />
                    <div class="mt-2 small text-muted">Ảnh hiện tại của slider</div>
                }
                else
                {
                    <div class="bg-light rounded p-5 text-center text-muted">
                        <i class="fas fa-image fa-4x mb-3"></i>
                        <p>Không có ảnh</p>
                    </div>
                }
            </div>

            <!-- Thông tin slider -->
            <div class="col-md-7 col-lg-8">
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold py-2">Tiêu đề slider</dt>
                    <dd class="col-sm-8 py-2">@Model.Title</dd>

                    <dt class="col-sm-4 fw-bold py-2">Link đích</dt>
                    <dd class="col-sm-8 py-2">
                        @if (!string.IsNullOrEmpty(Model.Link))
                        {
                            <a href="@Model.Link" target="_blank" class="text-primary">@Model.Link</a>
                        }
                        else
                        {
                            <span class="text-muted">Không có link</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold py-2">ID</dt>
                    <dd class="col-sm-8 py-2"><code>@Model.Id</code></dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" id="deleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mt-5 d-flex gap-3">
                <button type="submit" class="btn btn-danger btn-lg" id="confirmDeleteBtn">
                    <i class="fas fa-trash me-2"></i> Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i> Hủy và quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('deleteForm');
            const btn = document.getElementById('confirmDeleteBtn');

            form.addEventListener('submit', function (e) {
                e.preventDefault(); // Ngăn submit ngay

                Swal.fire({
                    title: 'Bạn có chắc chắn?',
                    html: `Xóa slider "<strong>${'@Model.Title'.Replace("\"", "&quot;")}</strong>"?<br>Không thể khôi phục sau khi xóa!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xóa vĩnh viễn',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xóa...';
                        form.submit(); // Submit thật sau khi confirm
                    }
                });
            });
        });
    </script>
}